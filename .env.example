# --- Model (any LiteLLM model string) ---------------------------------------------------------
# Anthropic:   LLM_MODEL=anthropic/claude-sonnet-5  + ANTHROPIC_API_KEY=...
# OpenAI:      LLM_MODEL=gpt-4o-mini                + OPENAI_API_KEY=...
# Local:       LLM_MODEL=ollama/llama3.1            (no key; needs Ollama running)
LLM_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cap on tokens per model reply. On models that think before answering this covers the thinking
# and the reply together, so don't set it too low: a truncated reply is not valid JSON.
LLM_MAX_TOKENS=8192
# Leave blank to use the provider's own default. Claude Sonnet 5, Claude Opus 5 and the Opus 4.7+
# family reject a non-default temperature with a 400, so only set this on models that accept it.
LLM_TEMPERATURE=

# --- Access -------------------------------------------------------------------------------------
# Comma-separated key:user:role entries (role is user or admin). Generate keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Laptop only: allow requests without a key, as user "dev" with admin role. Never in production.
# Set this to true while trying Agentheon out locally, then set API_KEYS and turn it back off.
AUTH_DEV_MODE=false

# --- Storage ------------------------------------------------------------------------------------
# SQLite by default. Production: postgresql+psycopg://user:pass@host:5432/agentheon
DATABASE_URL=sqlite:///agentheon.db

# --- Your domain ---------------------------------------------------------------------------------
SKILLS_DIRS=skills,examples/skills
TOOL_PACKS=examples.tool_packs.github_releases
GOVERNANCE_FILE=governance.yaml

# --- Behaviour ------------------------------------------------------------------------------------
MAX_STEPS=8
RUN_TIMEOUT_SECONDS=180
LEARNING_ENABLED=true
BEHAVIORAL_TTL_DAYS=90
WEB_TTL_DAYS=30

# --- Watches ------------------------------------------------------------------------------------
# Run the watch scheduler in this process. With several replicas, enable it on exactly one.
RUN_SCHEDULER=true
WATCH_POLL_SECONDS=30
# Optional: POST a JSON payload here when a watch detects a change at or above its threshold.
NOTIFY_WEBHOOK_URL=
